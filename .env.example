# MA Auto Trader — environment variables
# Copy this file to .env and fill in your real values.
# Note: systemd EnvironmentFile does NOT strip inline comments — keep comments on separate lines.

BINANCE_API_KEY=
BINANCE_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Trading mode: paper or live
TRADING_MODE=paper
# Optional: initial admin password (min 8 chars, letters + digits).
# If left empty on a fresh install, a random password is generated in data/admin_initial_password.txt.
ADMIN_PASSWORD=
# Optional: comma-separated allowed CORS origins (leave empty for same-origin only)
CORS_ORIGINS=
